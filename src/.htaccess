##########################
# Options

Options +FollowSymLinks
RewriteEngine On
ServerSignature Off


# do not show directory listing
Options -Indexes


# dodajemo utf8 charset u header
AddDefaultCharset UTF-8
AddCharset UTF-8 .css .htm .js .webmanifest


# Mime types
AddType application/manifest+json .webmanifest
AddType application/rdf+xml .rdf
AddType application/octet-stream .plist .safariextz
AddType application/x-7z-compressed .7z
AddType application/x-opera-extension .oex
AddType application/x-xpinstall .xpi
AddType font/eot .eot
AddType font/otf .otf
AddType font/ttf .ttf
AddType font/woff .woff
AddType font/woff2 .woff2
AddType text/plain .sha


##########################
# Security

# valid IP for restricted access
SetEnvIf Remote_Addr 95.180.123.42 ENV_IGOR=1
# SetEnvIf X-FORWARDED-FOR 95.180.123.42 ENV_IGOR=1


# deny access to protected server files - .htaccess, .htpasswd and all file names starting with dot
RedirectMatch 403 /\..*$


##########################
# Redirects

# http -> https
RewriteEngine on
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]


# use date in file name
RewriteRule ^assets\/css\/(.*)-\d{8,16}(\.min)?\.css$ assets/css/$1$2.css [NC,L]
RewriteRule ^assets\/js\/(.*)-\d{8,16}(\.min)?\.js$ assets/js/$1$2.js [NC,L]


##########################
# Caching

<ifModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    ExpiresByType text/html "access plus 5 minutes"
    ExpiresByType text/plain "access plus 5 minutes"
    ExpiresByType application/xhtml+xml "access plus 5 minutes"

    ExpiresByType text/css "access plus 3 months"
    ExpiresByType text/javascript "access plus 3 months"
    ExpiresByType text/x-javascript "access plus 3 months"
    ExpiresByType application/pdf "access plus 3 months"
    ExpiresByType application/x-shockwave-flash "access plus 3 months"
    ExpiresByType video/x-flv "access plus 3 months"

    ExpiresByType image/x-icon "access plus 3 months"
    ExpiresByType image/jpg "access plus 3 months"
    ExpiresByType image/jpeg "access plus 3 months"
    ExpiresByType image/gif "access plus 3 months"
    ExpiresByType image/png "access plus 3 months"
</ifModule>

<ifModule mod_headers.c>
    # Year
    <FilesMatch "\.(ico|pdf)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # Month
    <filesMatch "\.(gif|jpg|jpeg|png)">
        Header set Cache-Control "max-age=31536000, public"
    </filesMatch>

    # Month
    <filesMatch "\.(js|css|swf|ttf|otf|eot|woff|woff2|svg|xml)">
        Header set Cache-Control "max-age=31536000"
    </filesMatch>

    # 45 min
    <filesMatch "\.(html|htm|txt)">
        Header set Cache-Control "max-age=2700"
    </filesMatch>
</ifModule>

<IfModule mod_deflate.c>
    <IfModule mod_headers.c>
        Header append Vary User-Agent env=!dont-vary
    </IfModule>
    AddOutputFilterByType DEFLATE text/css text/x-component application/x-javascript application/javascript text/javascript text/x-js text/html text/richtext image/svg+xml text/plain text/xsd text/xsl text/xml image/x-icon application/json
    <IfModule mod_mime.c>
        # DEFLATE by extension
        AddOutputFilter DEFLATE js css htm html xml
    </IfModule>
</IfModule>


##########################

# service worker scope
<Files "service-worker.js">
    Header Set Service-Worker-allowed "/"
</Files>
